# ==============================================================================
# EV Charging Network Management System - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit the real .env file with actual credentials to version control.
# ==============================================================================

# Database Connection (PostgreSQL 18)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ev_charging_network
DB_USER=postgres
DB_PASSWORD=your_secure_postgresql_password_here
DB_SSLMODE=prefer
DATABASE_URL=postgresql+psycopg://postgres:your_secure_postgresql_password_here@localhost:5432/ev_charging_network

# Backend Application Settings (FastAPI)
API_HOST=127.0.0.1
API_PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend Client Settings (React + Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

